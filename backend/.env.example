# Backend Configuration - EXAMPLE
# Copy this file to .env and configure with your values

# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mextjs

# JWT
JWT_SECRET=your_super_secret_key_change_in_production_12345
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:3001

# AI Auto-Reply (optional)
# Set to 'true' to log AI auto-reply flow for debugging
# AI_AUTO_REPLY_DEBUG=true
# Gemini model (default: gemini-3-flash-preview per https://ai.google.dev/gemini-api/docs/quickstart)
# GEMINI_MODEL=gemini-3-flash-preview
